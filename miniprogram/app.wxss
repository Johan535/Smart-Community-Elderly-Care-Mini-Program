page {
  background: #f4f6f8;
  font-size: 32rpx;
  color: #1f2937;
}

.container {
  padding: 28rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-weight: bold;
  margin-bottom: 16rpx;
  font-size: 36rpx;
}

.input {
  border: 2rpx solid #d1d5db;
  border-radius: 12rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
  background: #fff;
  min-height: 52rpx;
}

.btn {
  margin-bottom: 14rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 12rpx;
}

.guide {
  background: #fff7ed;
  color: #9a3412;
  border-left: 8rpx solid #fb923c;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 18rpx;
  font-size: 28rpx;
}

.role-banner {
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  margin-bottom: 18rpx;
  color: #fff;
  font-weight: 600;
}

.elder-theme .role-banner {
  background: #16a34a;
}

.staff-theme .role-banner {
  background: #2563eb;
}

.elder-theme .title {
  color: #166534;
}

.staff-theme .title {
  color: #1d4ed8;
}

.large-text .title {
  font-size: 42rpx;
}

.large-text .guide {
  font-size: 32rpx;
}

.large-text .input {
  font-size: 36rpx;
  min-height: 64rpx;
}

.large-text .btn {
  font-size: 36rpx;
  min-height: 100rpx;
  line-height: 100rpx;
}
